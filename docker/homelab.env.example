# Copy this file to docker/homelab.env and edit it for your homelab.
# Do not commit docker/homelab.env.

# Host access
PAPERCLIP_PORT=3100
PAPERCLIP_PUBLIC_URL=http://orion.local:3100
PAPERCLIP_ALLOWED_HOSTNAMES=orion.local,orion.lan,orion.tailnet.example.ts.net

# Required secrets
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=replace-with-64-hex-chars

# PostgreSQL
POSTGRES_USER=paperclip
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=paperclip

# Persistent host paths. Use absolute paths on the homelab host.
POSTGRES_DATA_DIR=/srv/orion/postgres
PAPERCLIP_DATA_DIR=/srv/orion/paperclip
ORION_OBSIDIAN_VAULT_DIR=/srv/orion/obsidian-vault

# Optional local adapter credentials. Notion and GitHub integration tokens are
# configured inside Orion and stored as company-scoped secrets, not here.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
